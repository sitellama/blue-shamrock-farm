# Drupal host, no trailing slash required.
VITE_DRUPAL_BASE_URL=https://your-drupal-site.com

# Full JSON:API endpoint or a path relative to VITE_DRUPAL_BASE_URL.
# Example full URL:
# VITE_DRUPAL_SERVICES_ENDPOINT=https://your-drupal-site.com/jsonapi/node/service?include=field_image.field_media_image
# Example relative path:
VITE_DRUPAL_SERVICES_ENDPOINT=/jsonapi/node/service?include=field_image.field_media_image

# Optional: set to true if Drupal content requires a logged-in session cookie.
VITE_DRUPAL_ANIMALS_ENDPOINT=/jsonapi/node/animal?include=field_image
VITE_DRUPAL_INCLUDE_CREDENTIALS=false
